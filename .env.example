# Энэ файлыг .env нэрээр хуулж, утгуудыг бөглөнө. .env-ийг git-д бүү оруул.

# Сервер (EC2)-ийн гадаад IP. Өөрийн компьютер дээр туршихдаа: localhost
EC2_IP=
# Сангийн нууц үг (зөвхөн үсэг, тоо ашигла: @ : / зэрэг тэмдэгт хаягийг эвдэнэ)
POSTGRES_PASSWORD=
# Токены нууц түлхүүр. Үүсгэх: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
